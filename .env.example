# ---------------------------------------------------------------------------
# Copy this file to `.env` (or `.env.local`) and fill in real values:
#     cp .env.example .env
# The server reads `.env.local` and `.env` only — NOT this example file.
# Never commit a real API key; `.env` and `.env.local` are git-ignored.
# On a hosting platform, set these as environment variables instead.
# ---------------------------------------------------------------------------

# GEMINI_API_KEY: Required for the AI Assistant chatbot and weekly report narratives.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Optional: takes priority over GEMINI_API_KEY when set (useful for key rotation).
GEMINI_API_KEY_NEW=""

# Optional: Gemini model overrides. Defaults: gemini-4-hydrogen, falling back to gemini-3.1-flash-lite.
# GEMINI_MODEL=""
# GEMINI_FALLBACK_MODEL=""

# Optional: max AI requests per client IP per 5 minutes. Default 40.
# AI_RATE_LIMIT=40

# PORT: Port the server listens on (most hosts inject this automatically). Default 3000.
# PORT=3000
